// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      // F5 (launch.json) runs this default build task: type-check and bundle
      // on every change.
      "label": "watch",
      "dependsOn": ["npm: compile:watch", "npm: bundle:watch"],
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "npm",
      "script": "compile:watch",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never",
        "group": "watch"
      },
      "group": "build"
    },
    {
      "type": "npm",
      "script": "bundle:watch",
      // Matches the lines printed by esbuild.mjs in watch mode.
      "problemMatcher": {
        "owner": "esbuild",
        "fileLocation": "relative",
        "pattern": [
          {
            "regexp": "^✘ \\[ERROR\\] (.*)$",
            "message": 1
          },
          {
            "regexp": "^\\s+(.*):(\\d+):(\\d+):$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ],
        "background": {
          "activeBegins": true,
          "beginsPattern": "^\\[watch\\] build started",
          "endsPattern": "^\\[watch\\] build finished"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "never",
        "group": "watch"
      },
      "group": "build"
    }
  ]
}
