{
  "name": "pick-changes",
  "displayName": "Pick Changes",
  "description": "Open, stage and filter your git changes from a Quick Pick. Forked from Quick Open Git Status.",
  "version": "0.3.3",
  "publisher": "brandon-cercedo",
  "license": "MIT",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/brandon-cercedo/quick-open-changes.git"
  },
  "bugs": {
    "url": "https://github.com/brandon-cercedo/quick-open-changes/issues"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pick-changes.open",
        "title": "Pick Git changes"
      },
      {
        "command": "pick-changes.acceptSuggestion",
        "title": "Accept Filter Suggestion"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pick-changes.acceptSuggestion",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pick-changes.open",
        "key": "ctrl+g p",
        "mac": "cmd+g p"
      },
      {
        "key": "tab",
        "command": "pick-changes.acceptSuggestion",
        "when": "inQuickOpen && pickChanges.suggestionActive"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "pnpm run compile && pnpm run lint",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "dependencies": {
    "simple-git": "^4.0.2",
    "typesafe-utils": "^1.16.2"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.108.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
