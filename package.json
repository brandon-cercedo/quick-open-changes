{
  "name": "quick-open-git-status",
  "displayName": "Quick Open Git Status",
  "description": "Quickly opening changes files.",
  "version": "0.3.3",
  "publisher": "aki77",
  "license": "MIT",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aki77/vscode-quick-open-git-status.git"
  },
  "bugs": {
    "url": "https://github.com/aki77/vscode-quick-open-git-status/issues"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "quick-open-git-status.open",
        "title": "Quick open git status"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "pnpm run compile && pnpm run lint",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "dependencies": {
    "simple-git": "^4.0.2",
    "typesafe-utils": "^1.16.2"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.108.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
